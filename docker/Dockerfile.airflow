# The Airflow image for spec §7 milestone 16: the scheduler, api-server, dag-processor and
# triggerer all run from it, provisioned by terraform/modules/airflow.
#
# It carries dependencies, not this project's code — the repository is bind-mounted into the
# containers (platform-design §5.4 amendment 2), so an edit is measurable on the next DAG run
# without a rebuild of a 5.6 GB image. It also proves the thing it was originally built to prove:
# that this project's dependencies co-exist with Airflow, Cosmos, dbt and MLflow on one
# interpreter. The `check` extra is here so CI can run the DAG-parsing tests inside the image,
# which is the only environment where Airflow is importable.

FROM apache/airflow:3.3.1-python3.14

USER root
# XGBoost's OpenMP runtime, needed by the scoring tasks the DAG will call.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
USER airflow

ENV PYTHONHASHSEED=0 \
    OMP_NUM_THREADS=4 \
    MATCHER_WORKERS=4 \
    MATCHER_TAXA_DB=/opt/inat-cache/taxa.db

WORKDIR /opt/project

# Installed with pip rather than `uv sync`, deliberately: the Airflow base image manages its own
# environment, and replacing it with a uv-managed venv would mean re-solving Airflow's own
# constraint set. uv exports the same locked versions in a format pip understands, so the pins
# still come from uv.lock and cannot drift from the pipeline image's.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/home/airflow/.cache/uv \
    pip install --no-cache-dir uv==0.12.6 \
    && uv export --locked --no-emit-project --no-hashes \
         --extra dbt --extra tracking --extra airflow --extra check -o /tmp/requirements.txt \
    && pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

COPY README.md LICENSE ./
COPY src/ ./src/
RUN pip install --no-cache-dir --no-deps -e .
